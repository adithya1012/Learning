# ===================================
# Project Specific
# ===================================

# IndexedDBShim examples - temporary database files
javascript/IndexedDBShim/temp-db/
javascript/IndexedDBShim/*.db
javascript/IndexedDBShim/*.sqlite

# Vite projects - generated files
Vite/*/dist/
Vite/*/.vite/

# MeteorJS - local development files
MeteorJS/.meteor/local/
MeteorJS/.meteor/meteorite/

# Chatbots - build outputs
Chatbots/*/dist/
Chatbots/*/build/

# Protocol files - compiled outputs
protocol/*.js
protocol/*.d.ts

# SDK - build outputs
sdk/dist/
sdk/build/

# Screenshots and media (keep intentional ones)
screenshots/temp/
*.screenshot

# ===================================
# Performance & Profiling
# ===================================

# Chrome profiling
*.cpuprofile
*.heapprofile
*.heapsnapshot

# ===================================
